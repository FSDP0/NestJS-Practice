{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/mqtt/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/mqtt/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/mqtt",
  "projects": {
    "mqtt": {
      "type": "application",
      "root": "apps/mqtt",
      "entryFile": "main",
      "sourceRoot": "apps/mqtt/src",
      "compilerOptions": {
        "tsConfigPath": "apps/mqtt/tsconfig.app.json"
      }
    },
    "amqp": {
      "type": "application",
      "root": "apps/amqp",
      "entryFile": "main",
      "sourceRoot": "apps/amqp/src",
      "compilerOptions": {
        "tsConfigPath": "apps/amqp/tsconfig.app.json"
      }
    },
    "kafka": {
      "type": "application",
      "root": "apps/kafka",
      "entryFile": "main",
      "sourceRoot": "apps/kafka/src",
      "compilerOptions": {
        "tsConfigPath": "apps/kafka/tsconfig.app.json"
      }
    }
  }
}